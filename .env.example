# Copy to .env if you want to change these. Both are optional.
# API keys are NOT set here: you enter them on the app's Settings page.
# PORT must be a whole number from 1 to 65535. The app stops with a message if it is not.
PORT=3000
# 127.0.0.1 = only this computer can open the app (safe default).
# 0.0.0.0 = other devices on your Wi-Fi can open it too. The app has no login,
# and it spends your API credit, so only do this on a network you trust.
HOST=127.0.0.1
